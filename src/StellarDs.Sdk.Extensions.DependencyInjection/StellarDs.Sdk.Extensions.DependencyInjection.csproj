<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>StellarDs.Sdk.Extensions.DependencyInjection</RootNamespace>
    <PackageId>Stellards.SDK.Extensions.DependencyInjection</PackageId>
    <Title>StellarDS SDK - dependency injection</Title>
    <Description>Registers the StellarDS client (Stellards.SDK) with Microsoft.Extensions.DependencyInjection and IHttpClientFactory: services.AddStellarDs(...).</Description>
    <PackageTags>StellarDS;Stellar DataStore;dependency injection;HttpClientFactory</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StellarDs.Sdk\StellarDs.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
