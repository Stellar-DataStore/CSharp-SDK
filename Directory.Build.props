<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Authors>TMS Software</Authors>
    <Company>TMS Software</Company>
    <Copyright>Copyright (c) TMS Software</Copyright>
    <RepositoryUrl>https://github.com/stellar-datastore/CSharp-SDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://stellards.io</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
